{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/orchestrator-plan.schema.json",
  "title": "Codex orchestration plan response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "requirements", "acceptance_criteria", "risk_band", "architecture_context", "documentation_context", "capabilities_used", "increments", "decision_context", "dependencies", "blockers", "engineering_discovery"],
  "properties": {
    "decision": {"enum": ["READY", "NEEDS_HUMAN_INPUT"]},
    "summary": {"type": "string"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/sourceRecord"}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/sourceRecord"}},
    "risk_band": {"enum": ["low", "medium", "high"]},
    "architecture_context": {"type": "array", "items": {"type": "string"}},
    "documentation_context": {"type": "array", "items": {"type": "string"}},
    "capabilities_used": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "increments": {"type": "array", "items": {"$ref": "#/$defs/increment"}},
    "decision_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "question", "proposal", "alternatives", "reason", "policy_or_skill_reference", "required_authority", "interactive_resolution_allowed"],
      "properties": {
        "category": {"enum": ["functional_decision", "external_data_transfer_authorization", "restricted_operation_authorization", "security_risk_acceptance", "high_risk_approval", "criterion_waiver", "unclassified_human_decision"]},
        "question": {"type": "string"},
        "proposal": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "policy_or_skill_reference": {"type": ["string", "null"]},
        "required_authority": {"type": "string"},
        "interactive_resolution_allowed": {"type": "boolean"}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "engineering_discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["quality_requirements", "constraints_and_dependencies", "ambiguities", "scenarios", "assumptions", "decisions"],
      "properties": {
        "quality_requirements": {"type": "array", "items": {"$ref": "#/$defs/sourceRecord"}},
        "constraints_and_dependencies": {"type": "array", "items": {"$ref": "#/$defs/sourceRecord"}},
        "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
        "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
      }
    }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "source"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "increment": {
      "type": "object", "additionalProperties": false,
      "required": ["increment_id", "title", "code_paths", "artifact_paths", "revision_paths", "acceptance_criteria_ids", "validation_ids", "blocked_by_decision"],
      "properties": {
        "increment_id": {"type": "string"},
        "title": {"type": "string"},
        "code_paths": {"$ref": "#/$defs/paths"},
        "artifact_paths": {"$ref": "#/$defs/paths"},
        "revision_paths": {"$ref": "#/$defs/paths"},
        "acceptance_criteria_ids": {"$ref": "#/$defs/ids"},
        "validation_ids": {"$ref": "#/$defs/ids"},
        "blocked_by_decision": {"type": "boolean", "description": "When true, this increment waits for the plan's pending decision; independent increments may proceed."}
      }
    },
    "paths": {"type": "array", "items": {"type": "string"}},
    "ids": {"type": "array", "items": {"type": "string"}},
    "ambiguity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "impact", "recommendation", "requires_human_input"],
      "properties": {
        "id": {"type": "string"}, "question": {"type": "string"}, "impact": {"type": "string"},
        "recommendation": {"type": "string"}, "requires_human_input": {"type": "boolean"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scenario", "expected_behavior", "verification", "requirement_ids"],
      "properties": {
        "id": {"type": "string"}, "scenario": {"type": "string"},
        "expected_behavior": {"type": "string"}, "verification": {"type": "string"},
        "requirement_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "rationale", "impact_if_wrong", "reversible", "requires_confirmation"],
      "properties": {
        "id": {"type": "string"}, "description": {"type": "string"}, "rationale": {"type": "string"},
        "impact_if_wrong": {"type": "string"}, "reversible": {"type": "boolean"},
        "requires_confirmation": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "decision", "rationale", "alternatives", "requires_human_input"],
      "properties": {
        "id": {"type": "string"}, "category": {"enum": ["engineering", "technical_tradeoff", "product_business"]},
        "decision": {"type": "string"}, "rationale": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "requires_human_input": {"type": "boolean"}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "source_reference", "phases", "use_rationale", "limitations"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["skill", "agent_instruction", "tool_guidance", "workflow"]},
        "source_reference": {"type": "string"},
        "phases": {"type": "array", "items": {"enum": ["DISCOVERY", "REQUIREMENTS", "ARCHITECTURE", "PLANNING", "IMPLEMENTATION", "TESTING", "INDEPENDENT_VERIFICATION", "CORRECTION", "VERIFICATION_GATE", "COMMIT", "NEXT_INCREMENT"]}},
        "use_rationale": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
