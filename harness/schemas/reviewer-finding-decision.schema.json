{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/reviewer-finding-decision.schema.json",
  "title": "Primary agent decision on a reviewer finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "round_number", "decision", "reason", "evidence_references", "resolution_evidence_references", "resolution_status", "material_disagreement"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "round_number": {"type": "integer", "enum": [1, 2]},
    "decision": {"enum": ["ACCEPT", "REJECT", "PARTIAL", "DEFER"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accepted_portion": {"type": "string"},
    "resolution_evidence_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resolution_status": {"enum": ["awaiting_correction", "verified", "resolved", "human_intervention_required"]},
    "material_disagreement": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"enum": ["REJECT", "PARTIAL"]}}, "required": ["decision"]}, "then": {"properties": {"evidence_references": {"minItems": 1}}}},
    {"if": {"properties": {"decision": {"const": "PARTIAL"}}, "required": ["decision"]}, "then": {"required": ["accepted_portion"], "properties": {"accepted_portion": {"minLength": 1}}}},
    {"if": {"properties": {"decision": {"const": "DEFER"}}, "required": ["decision"]}, "then": {"properties": {"resolution_status": {"const": "human_intervention_required"}}}},
    {"if": {"properties": {"decision": {"enum": ["ACCEPT", "PARTIAL"]}}, "required": ["decision"]}, "then": {"properties": {"resolution_status": {"enum": ["awaiting_correction", "verified"]}}}}
  ]
}
