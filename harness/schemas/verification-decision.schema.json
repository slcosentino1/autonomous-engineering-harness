{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/verification-decision.schema.json",
  "title": "Verification gate decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "target_id", "increment_id", "target_revision_id", "revision_manifest_reference", "outcome", "risk_band", "scope", "decided_at", "rationale", "implementation_agent_identity", "implementation_session_identity", "implementation_identity_assurance", "authority", "evidence_references", "findings_source_reference", "findings_catalog_fingerprint", "reviewers", "blocking_findings", "accepted_risk_findings", "open_decisions"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "increment_id": {"type": "string", "minLength": 1},
    "target_revision_id": {"type": "string", "pattern": "^content:[a-f0-9]{64}$", "description": "Immutable content identity under review, not a commit SHA."},
    "revision_manifest_reference": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["APPROVE", "REJECT_REQUEST_CORRECTION", "REQUEST_EVIDENCE", "ESCALATE"]},
    "risk_band": {"enum": ["low", "medium", "high"]},
    "scope": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "implementation_agent_identity": {"type": "string", "minLength": 1},
    "implementation_session_identity": {"type": "string", "minLength": 1},
    "implementation_identity_assurance": {"enum": ["declared", "externally_authenticated"]},
    "implementation_authentication_reference": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "identity_assurance", "role", "authority_reference"],
      "properties": {
        "kind": {"enum": ["policy_evaluator", "human_gate_approver"]},
        "identity": {"type": "string", "minLength": 1},
        "identity_assurance": {"enum": ["declared", "externally_authenticated"]},
        "authentication_reference": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "authority_reference": {"type": "string", "minLength": 1}
      }
    },
    "evidence_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "findings_source_reference": {"type": "string", "minLength": 1},
    "findings_catalog_fingerprint": {"type": "string", "minLength": 1},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "assignment_reference", "identity", "identity_assurance", "kind", "role", "session_identity", "reviewed_revision_id", "reviewed_scope_paths", "review_completion", "scope_complete_attestation", "required_checks_remaining", "unverified_areas", "limitations", "independence_basis", "recommendation", "report_reference"],
        "properties": {
          "review_id": {"type": "string", "minLength": 1},
          "assignment_reference": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "identity_assurance": {"enum": ["declared", "externally_authenticated"]},
          "authentication_reference": {"type": "string", "minLength": 1},
          "kind": {"enum": ["human", "agent_session"]},
          "role": {"type": "string", "minLength": 1},
          "session_identity": {"type": "string", "minLength": 1},
          "reviewed_revision_id": {"type": "string", "pattern": "^content:[a-f0-9]{64}$"},
          "reviewed_scope_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_completion": {"enum": ["complete", "incomplete"]},
          "scope_complete_attestation": {"type": "boolean"},
          "required_checks_remaining": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "unverified_areas": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "independence_basis": {"type": "string", "minLength": 1},
          "recommendation": {"enum": ["approve", "correct", "request_evidence", "escalate"]},
          "report_reference": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"identity_assurance": {"const": "externally_authenticated"}}, "required": ["identity_assurance"]}, "then": {"required": ["authentication_reference"]}},
          {"if": {"properties": {"review_completion": {"const": "complete"}}, "required": ["review_completion"]}, "then": {"properties": {"scope_complete_attestation": {"const": true}, "required_checks_remaining": {"maxItems": 0}}}},
          {"if": {"properties": {"review_completion": {"const": "incomplete"}}, "required": ["review_completion"]}, "then": {"properties": {"scope_complete_attestation": {"const": false}}}}
        ]
      }
    },
    "blocking_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Exact evaluator-derived IDs of all unresolved blocking findings from the complete canonical register."},
    "accepted_risk_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Exact evaluator-derived IDs of all validly accepted risks from the complete canonical register."},
    "open_decisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_approval_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"implementation_identity_assurance": {"const": "externally_authenticated"}}, "required": ["implementation_identity_assurance"]},
      "then": {"required": ["implementation_authentication_reference"]}
    },
    {
      "if": {"properties": {"authority": {"properties": {"identity_assurance": {"const": "externally_authenticated"}}, "required": ["identity_assurance"]}}, "required": ["authority"]},
      "then": {"properties": {"authority": {"required": ["authentication_reference"]}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "blocking_findings": {"maxItems": 0},
          "open_decisions": {"maxItems": 0},
          "evidence_references": {"minItems": 1},
          "reviewers": {"items": {"properties": {"review_completion": {"const": "complete"}, "scope_complete_attestation": {"const": true}, "required_checks_remaining": {"maxItems": 0}}}}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}, "risk_band": {"const": "low"}, "accepted_risk_findings": {"maxItems": 0}}, "required": ["outcome", "risk_band", "accepted_risk_findings"]},
      "then": {"properties": {"authority": {"properties": {"kind": {"const": "policy_evaluator"}}, "required": ["kind"]}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}, "risk_band": {"const": "high"}}, "required": ["outcome", "risk_band"]},
      "then": {
        "required": ["implementation_authentication_reference"],
        "properties": {
          "implementation_identity_assurance": {"const": "externally_authenticated"},
          "authority": {"properties": {"kind": {"const": "human_gate_approver"}}, "required": ["kind"]},
          "reviewers": {
            "minItems": 1,
            "contains": {"properties": {"kind": {"const": "human"}, "identity_assurance": {"const": "externally_authenticated"}, "authentication_reference": {"type": "string", "minLength": 1}, "review_completion": {"const": "complete"}, "scope_complete_attestation": {"const": true}}, "required": ["kind", "identity_assurance", "authentication_reference", "review_completion", "scope_complete_attestation"]},
            "items": {"if": {"properties": {"kind": {"const": "human"}}, "required": ["kind"]}, "then": {"properties": {"identity_assurance": {"const": "externally_authenticated"}}, "required": ["authentication_reference"]}}
          },
          "human_approval_references": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}, "risk_band": {"const": "medium"}}, "required": ["outcome", "risk_band"]},
      "then": {"properties": {"reviewers": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}, "risk_band": {"const": "medium"}, "accepted_risk_findings": {"maxItems": 0}}, "required": ["outcome", "risk_band", "accepted_risk_findings"]},
      "then": {"properties": {"authority": {"properties": {"kind": {"const": "policy_evaluator"}}, "required": ["kind"]}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "APPROVE"}, "accepted_risk_findings": {"minItems": 1}}, "required": ["outcome", "accepted_risk_findings"]},
      "then": {
        "required": ["implementation_authentication_reference"],
        "properties": {
          "implementation_identity_assurance": {"const": "externally_authenticated"},
          "authority": {"properties": {"kind": {"const": "human_gate_approver"}}, "required": ["kind"]},
          "reviewers": {"items": {"if": {"properties": {"kind": {"const": "human"}}, "required": ["kind"]}, "then": {"properties": {"identity_assurance": {"const": "externally_authenticated"}}, "required": ["authentication_reference"]}}},
          "human_approval_references": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"authority": {"properties": {"kind": {"const": "human_gate_approver"}}, "required": ["kind"]}}, "required": ["authority"]},
      "then": {"properties": {"authority": {"properties": {"identity_assurance": {"const": "externally_authenticated"}, "authentication_reference": {"type": "string", "minLength": 1}}, "required": ["authentication_reference"]}}}
    }
  ]
}
