{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/evidence.schema.json",
  "title": "Verification evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "target_id", "increment_id", "kind", "description", "observed_at", "observed_result", "revision"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "increment_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["command", "test", "file_reference", "artifact", "observation", "review"]},
    "description": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "observed_result": {"type": "string", "minLength": 1},
    "command": {"type": "string"},
    "working_directory": {"type": "string"},
    "exit_code": {"type": "integer"},
    "artifact_reference": {"type": ["string", "null"]},
    "source_reference": {"type": "string"},
    "criterion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "review_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_cycle_id", "review_round", "review_id", "assignment_reference", "reviewer_role", "reviewer_identity", "reviewer_session_identity", "identity_assurance", "invocation_method", "executable", "started_at", "finished_at", "duration_ms", "process_exit_code", "failure_kind", "envelope_valid", "report_valid", "stdout_sha256", "stderr_sha256", "prompt_sha256", "report_sha256", "report_reference", "reviewer_contract_reference", "reviewer_contract_sha256", "external_authorization_reference", "authorization_scope_sha256", "authorization_verification_reference", "review_manifest_sha256", "invocation_attempted_at", "snapshot_sha256", "snapshot_file_paths", "stderr_summary_redacted", "command_template"],
      "properties": {
        "review_cycle_id": {"type": "string", "minLength": 1},
        "review_round": {"type": "integer", "enum": [1, 2]},
        "review_id": {"type": "string", "minLength": 1},
        "assignment_reference": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "usage": {"type": ["object", "null"]},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "reviewer_identity": {"const": "Claude"},
        "reviewer_session_identity": {"type": ["string", "null"], "minLength": 1},
        "identity_assurance": {"const": "declared"},
        "invocation_method": {"const": "aily claude"},
        "executable": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "process_exit_code": {"type": ["integer", "null"]},
        "failure_kind": {"type": ["string", "null"], "enum": ["process_launch_failure", "authentication_failure", "reviewer_execution_failure", "invalid_json", "empty_response", "invalid_reviewer_report", "stale_revision", "request_validation_failure", null]},
        "envelope_valid": {"type": "boolean"},
        "report_valid": {"type": "boolean"},
        "stdout_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "response_metadata": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "response_field": {"const": "result"},
            "envelope_type": {"const": "result"},
            "subtype": {"type": "string", "maxLength": 48},
            "is_error": {"type": "boolean"},
            "session_id": {"type": "string", "maxLength": 160},
            "invocation_id": {"type": "string", "maxLength": 160},
            "request_id": {"type": "string", "maxLength": 160},
            "model": {"type": "string", "maxLength": 128},
            "cost_usd": {"type": "number", "minimum": 0},
            "usage": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "input_tokens": {"type": "integer", "minimum": 0},
                "output_tokens": {"type": "integer", "minimum": 0},
                "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
                "cache_read_input_tokens": {"type": "integer", "minimum": 0},
                "output_tokens_details": {"type": "object", "additionalProperties": false, "properties": {"thinking_tokens": {"type": "integer", "minimum": 0}}},
                "server_tool_use": {"type": "object", "additionalProperties": false, "properties": {"web_search_requests": {"type": "integer", "minimum": 0}, "web_fetch_requests": {"type": "integer", "minimum": 0}}},
                "cache_creation": {"type": "object", "additionalProperties": false, "properties": {"ephemeral_1h_input_tokens": {"type": "integer", "minimum": 0}, "ephemeral_5m_input_tokens": {"type": "integer", "minimum": 0}}},
                "service_tier": {"type": "string", "maxLength": 48}
              }
            }
          }
        },
        "diagnostic": {"type": ["string", "null"], "maxLength": 1200},
        "validation_errors": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1200}},
        "report_reference": {"type": ["string", "null"]},
        "reviewer_contract_reference": {"type": "string", "minLength": 1},
        "reviewer_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "external_authorization_reference": {"type": "string", "minLength": 1},
        "authorization_scope_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "authorization_verification_reference": {"type": ["string", "null"], "minLength": 1},
        "review_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "invocation_attempted_at": {"type": ["string", "null"], "format": "date-time"},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "snapshot_file_paths": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stderr_summary_redacted": {"type": "string"},
        "command_template": {"type": "string", "minLength": 1}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_state", "baseline_commit", "revision_id", "scope_paths", "fingerprint"],
      "properties": {
        "source_state": {"enum": ["commit", "working_tree"]},
        "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "revision_id": {"type": "string", "pattern": "^content:[a-f0-9]{64}$", "description": "Immutable content identity for workflow revision_paths; never a commit SHA or mutable worktree label."},
        "scope_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "description": "Subset of revision_paths covered by this evidence."}},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 manifest fingerprint for the evidence's declared scope."},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$", "description": "Commit provenance for source_state=commit; separate from revision_id."},
        "environment_fingerprint": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"source_state": {"const": "commit"}}, "required": ["source_state"]}, "then": {"required": ["commit_sha"]}},
        {"if": {"properties": {"source_state": {"const": "working_tree"}}, "required": ["source_state"]}, "then": {"not": {"required": ["commit_sha"]}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["command", "test"]}}, "required": ["kind"]},
      "then": {"required": ["command", "working_directory", "exit_code"]}
    },
    {
      "if": {"required": ["review_execution"]},
      "then": {
        "properties": {"kind": {"const": "review"}},
        "allOf": [
          {
            "if": {"properties": {"review_execution": {"properties": {"report_valid": {"const": true}}, "required": ["report_valid"]}}, "required": ["review_execution"]},
            "then": {"properties": {"review_execution": {"required": ["report_reference"], "properties": {"reviewer_session_identity": {"type": "string", "minLength": 1}, "envelope_valid": {"const": true}, "failure_kind": {"type": "null"}, "report_reference": {"type": "string", "minLength": 1}, "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "authorization_scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "authorization_verification_reference": {"type": "string", "minLength": 1}, "review_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "invocation_attempted_at": {"type": "string", "format": "date-time"}, "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "snapshot_file_paths": {"type": "array"}}}}}
          },
          {
            "if": {"properties": {"review_execution": {"properties": {"report_valid": {"const": false}}, "required": ["report_valid"]}}, "required": ["review_execution"]},
            "then": {"properties": {"review_execution": {"properties": {"failure_kind": {"type": "string"}, "report_reference": {"type": "null"}, "report_sha256": {"type": "null"}}}}}
          }
        ]
      }
    }
  ]
}
