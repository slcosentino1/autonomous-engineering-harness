{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/orchestrator-plan-refinement.schema.json",
  "title": "Codex plan review finding disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "plan", "dispositions"],
  "properties": {
    "status": {"enum": ["COMPLETED", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1},
    "plan": {"type": "object"},
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "decision", "rationale", "plan_change", "evidence_references"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["ACCEPT", "REJECT"]},
          "rationale": {"type": "string", "minLength": 1},
          "plan_change": {"type": ["string", "null"]},
          "evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
