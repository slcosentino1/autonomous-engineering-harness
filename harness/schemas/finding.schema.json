{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/finding.schema.json",
  "title": "Verification finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "target_id", "increment_id", "reviewed_revision_id", "source_reviews", "severity", "classification", "title", "description", "evidence_ids", "impact", "recommendation", "disposition"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "increment_id": {"type": "string", "minLength": 1},
    "reviewed_revision_id": {"type": "string", "pattern": "^content:[a-f0-9]{64}$"},
    "source_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "reviewer_identity", "reviewer_kind", "identity_assurance", "reviewer_session_identity", "report_reference"],
        "properties": {
          "review_id": {"type": "string", "minLength": 1},
          "reviewer_identity": {"type": "string", "minLength": 1},
          "reviewer_kind": {"enum": ["human", "agent_session"]},
          "identity_assurance": {"enum": ["declared", "externally_authenticated"]},
          "authentication_reference": {"type": "string", "minLength": 1},
          "reviewer_session_identity": {"type": "string", "minLength": 1},
          "report_reference": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"identity_assurance": {"const": "externally_authenticated"}}, "required": ["identity_assurance"]}, "then": {"required": ["authentication_reference"]}}
        ]
      },
      "description": "All review reports that independently recorded this finding. Cross-record validation checks these references against complete review reports."
    },
    "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational"]},
    "classification": {"enum": ["confirmed_defect", "potential_risk", "known_limitation", "optional_improvement", "test_coverage_suggestion", "documentation_editorial"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "location": {"type": "string"},
    "scenario": {"type": "string"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "impact": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["open", "fixed", "accepted_risk", "deferred", "not_reproducible"]},
    "disposition_rationale": {"type": "string"},
    "resolution_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "follow_up_owner": {"type": "string"},
    "review_by": {"type": "string", "format": "date"},
    "risk_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "impact", "compensating_controls", "residual_risk", "owner", "review_by", "authorizer_identity", "authorizer_kind", "authorizer_role", "authorizer_identity_assurance", "authorizer_authentication_reference", "authority_reference", "authorized_at"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "residual_risk": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "review_by": {"type": "string", "format": "date"},
        "authorizer_identity": {"type": "string", "minLength": 1},
        "authorizer_kind": {"const": "human"},
        "authorizer_role": {"type": "string", "minLength": 1},
        "authorizer_identity_assurance": {"const": "externally_authenticated"},
        "authorizer_authentication_reference": {"type": "string", "minLength": 1},
        "authority_reference": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "accepted_risk"}}, "required": ["disposition"]},
      "then": {"required": ["risk_acceptance"], "properties": {"severity": {"enum": ["Medium", "Low", "Informational"]}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "deferred"}}, "required": ["disposition"]},
      "then": {"required": ["disposition_rationale", "follow_up_owner", "review_by"]}
    },
    {
      "if": {"properties": {"disposition": {"enum": ["fixed", "not_reproducible"]}}, "required": ["disposition"]},
      "then": {"required": ["disposition_rationale", "resolution_evidence_ids"], "properties": {"resolution_evidence_ids": {"minItems": 1}}}
    }
  ]
}
