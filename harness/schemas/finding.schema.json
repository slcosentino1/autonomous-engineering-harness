{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-engineering-harness/finding.schema.json",
  "title": "Verification finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "severity", "classification", "title", "description", "evidence", "impact", "recommendation"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational"]},
    "classification": {"enum": ["confirmed_defect", "potential_risk", "known_limitation", "optional_improvement"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "location": {"type": "string"},
    "scenario": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "impact": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["open", "fixed", "accepted_risk", "deferred", "not_reproducible"]}
  }
}
